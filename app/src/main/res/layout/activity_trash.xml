<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/snap_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/trashToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/snap_surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/snap_text"
        app:title="휴지통"
        app:titleTextColor="@color/snap_text" />

    <LinearLayout
        android:id="@+id/trashSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/snap_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/trashSelectedCountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/snap_text"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="2개 선택" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/restoreSelectedButton"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="복원"
            android:textColor="@color/snap_text"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/snap_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/permanentDeleteSelectedButton"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="영구삭제"
            android:textColor="@color/snap_rose"
            app:icon="@drawable/ic_trash"
            app:iconTint="@color/snap_rose" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearTrashSelectionButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="해제"
            android:textColor="@color/snap_text_secondary" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trashRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp"
        tools:listitem="@layout/item_memory_card" />

    <TextView
        android:id="@+id/trashEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="휴지통이 비어 있어요."
        android:textColor="@color/snap_text_secondary"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
