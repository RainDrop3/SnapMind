<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/snap_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/developerToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/snap_surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/snap_text"
        app:title="개발자 소개"
        app:titleTextColor="@color/snap_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_badge_primary"
            android:gravity="center"
            android:text="SM"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="SnapMind Project Team"
            android:textColor="@color/snap_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="SnapMind는 스크린샷을 단순히 보관하는 대신 OCR, 이미지 분류, 자동 태그, 메모 추천으로 필요한 순간 다시 찾기 쉽게 정리하는 개인 기억 저장소입니다."
            android:textColor="@color/snap_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_developer_project_info"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:text="이미지 속 URL은 제목, 설명, 대표 이미지를 담은 링크 카드로 보여주고 YouTube 링크는 썸네일과 영상 정보를 보강합니다.&#10;&#10;악성 링크 경고, Gemini 저장 이유 추천, 화질 업그레이드, 갤러리 저장, 검색, 태그, 즐겨찾기, 휴지통, PDF 내보내기까지 스크린샷을 수집한 뒤 다시 활용하는 흐름을 한 곳에서 이어갑니다."
            android:textColor="@color/snap_text"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
