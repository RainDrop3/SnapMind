<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/snap_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/shareToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/snap_surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/snap_text"
        app:title="SnapMind에 저장"
        app:titleTextColor="@color/snap_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/sharePreview"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@color/snap_surface"
            android:contentDescription="가져온 이미지 미리보기"
            android:scaleType="centerCrop" />

        <ProgressBar
            android:id="@+id/shareProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/shareProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="이미지를 분석하고 있어요…"
            android:textColor="@color/snap_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shareProgressDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="OCR · 자동 분류가 끝나면 상세 화면으로 이동합니다."
            android:textColor="@color/snap_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
