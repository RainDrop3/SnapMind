<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/snap_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/detailToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/snap_surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/snap_text"
        app:title="상세"
        app:titleTextColor="@color/snap_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <FrameLayout
                android:id="@+id/detailPreviewFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="240dp"
                android:background="@drawable/bg_thumbnail_code">

                <ImageView
                    android:id="@+id/detailImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="이미지 원본"
                    android:maxHeight="560dp"
                    android:minHeight="240dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/detailGlyph"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="42sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/imageEnhancementButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:text="화질 업그레이드"
                app:icon="@drawable/ic_spark" />

            <!-- 위쪽 행: 카테고리(최대 2개, 사용자 편집) -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/detailCategoryChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                app:singleLine="true" />

            <!-- 아래쪽 행: 태그 -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/detailChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp" />

            <TextView
                android:id="@+id/updatedAtText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="6dp"
                android:textColor="@color/snap_text_secondary"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="저장 이유 메모">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/memoEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="4"
                        android:textColor="@color/snap_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <ProgressBar
                    android:id="@+id/memoLoadingIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/geminiSuggestButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:text="Gemini 메모 추천받기"
                app:icon="@drawable/ic_spark" />

            <com.google.android.material.chip.Chip
                android:id="@+id/geminiSuggestionChip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:checkable="false"
                android:textColor="@color/snap_primary"
                app:chipBackgroundColor="@color/snap_surface_soft"
                app:closeIconVisible="true"
                app:chipIcon="@drawable/ic_spark"
                app:chipIconTint="@color/snap_primary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/linkPreviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone"
                app:cardBackgroundColor="@color/snap_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/snap_outline"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="104dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/linkPreviewImage"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:contentDescription="링크 대표 이미지"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        tools:src="@drawable/bg_thumbnail_code"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/linkPreviewSite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/snap_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="developer.android.com" />

                        <TextView
                            android:id="@+id/linkSafetyWarning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_badge_error"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="위험 가능성이 있는 링크"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/linkPreviewTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp"
                            android:maxLines="2"
                            android:textColor="@color/snap_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Android Developers" />

                        <TextView
                            android:id="@+id/linkPreviewDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp"
                            android:maxLines="2"
                            android:textColor="@color/snap_text_secondary"
                            android:textSize="13sp"
                            tools:text="Tools and APIs for building Android apps." />

                        <TextView
                            android:id="@+id/linkPreviewUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/snap_text_secondary"
                            android:textSize="12sp"
                            tools:text="https://developer.android.com" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/ocrHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_badge_soft"
                android:padding="14dp"
                android:text="OCR 텍스트 보기"
                android:textColor="@color/snap_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ocrText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:background="@color/snap_surface"
                android:padding="14dp"
                android:textColor="@color/snap_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/snap_surface"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/favoriteDetailButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="54dp"
            android:layout_height="52dp"
            android:contentDescription="즐겨찾기"
            app:icon="@drawable/ic_heart"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="54dp"
            android:layout_height="52dp"
            android:contentDescription="휴지통으로 이동"
            app:icon="@drawable/ic_trash"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveMemoButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="저장"
            app:icon="@drawable/ic_check" />
    </LinearLayout>
</LinearLayout>
